---
import Page from '@/components/layout/Page.astro';
import { loadCryptoSummary } from '@/lib/data';
import { EmptyState } from '@/components/layout/EmptyState';
import { StaleBadge } from '@/components/layout/StaleBadge';
import { YearlySummary } from '@/components/crypto/YearlySummary';
import { HoldingsSummary } from '@/components/crypto/HoldingsSummary';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';

const crypto = loadCryptoSummary();
---
<Page title="Crypto">
  {!crypto ? (
    <EmptyState domain="crypto" command="Run /finz:crypto ingest" />
  ) : (
    <div class="space-y-6">
      <div class="flex items-baseline">
        <div>
          <div class="text-xs uppercase tracking-wider text-muted-foreground">Ledger generated</div>
          <div class="text-sm tabular">{crypto.generated_at.slice(0, 10)}</div>
        </div>
        <StaleBadge lastUpdated={crypto.generated_at} />
      </div>

      {crypto.holdings && crypto.holdings.length > 0 && (
        <Card>
          <CardHeader><CardTitle className="text-sm">Top holdings</CardTitle></CardHeader>
          <CardContent><HoldingsSummary holdings={crypto.holdings} /></CardContent>
        </Card>
      )}

      {crypto.yearly_tax_summary && (
        <Card>
          <CardHeader><CardTitle className="text-sm">§23 / §22 Nr.3 by year</CardTitle></CardHeader>
          <CardContent><YearlySummary summary={crypto.yearly_tax_summary} /></CardContent>
        </Card>
      )}
    </div>
  )}
</Page>
