---
import Page from '@/components/layout/Page.astro';
import { loadAll } from '@/lib/data';
import { computeTaxReadiness } from '@/lib/insights';
import { EmptyState } from '@/components/layout/EmptyState';
import { StaleBadge } from '@/components/layout/StaleBadge';
import { TaxReadinessCard } from '@/components/dashboard/TaxReadinessCard';
import { IncomeSummary } from '@/components/tax/IncomeSummary';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';

const state = loadAll();
const tax = state.tax;
const readiness = computeTaxReadiness(state);
---
<Page title="Tax">
  {!tax ? (
    <EmptyState domain="tax" command="Run /finz:steuer start" />
  ) : (
    <div class="space-y-6">
      <div class="flex items-baseline">
        <div>
          <div class="text-xs uppercase tracking-wider text-muted-foreground">Filing year · status</div>
          <div class="text-xl font-semibold">{tax.tax_year} · {tax.filing_status ?? '—'}</div>
        </div>
        <StaleBadge lastUpdated={tax.last_updated} />
      </div>

      <TaxReadinessCard readiness={readiness} />

      <Card>
        <CardHeader><CardTitle className="text-sm">Employer income</CardTitle></CardHeader>
        <CardContent><IncomeSummary tax={tax} /></CardContent>
      </Card>

      <Card>
        <CardHeader><CardTitle className="text-sm">Phases completed</CardTitle></CardHeader>
        <CardContent>
          <ul class="flex flex-wrap gap-2 text-xs">
            {(tax.phases_completed ?? []).map(phase => (
              <li class="rounded border border-border bg-muted px-2 py-1">{phase}</li>
            ))}
            {(tax.phases_completed ?? []).length === 0 && <span class="text-muted-foreground">None yet.</span>}
          </ul>
        </CardContent>
      </Card>
    </div>
  )}
</Page>
